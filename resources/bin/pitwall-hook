#!/bin/sh
# Pitwall hook: reads a Claude Code hook payload on stdin, appends one compact JSON line to $1.
# Usage: pitwall-hook <eventsFile> <pitwallSessionId>. Always exits 0; never writes to stdout.
exec >/dev/null 2>&1

JQ=/usr/bin/jq
[ -x "$JQ" ] || JQ=$(command -v jq) || exit 0
[ -n "$JQ" ] || exit 0

input=$(cat)
mkdir -p "$(dirname "$1")" || exit 0

line=$(printf '%s' "$input" | "$JQ" -c --arg c "$2" '{c:$c, t:(now*1000|floor), e:.hook_event_name, sid:.session_id, tool:.tool_name,
  nt:.notification_type, src:.source, reason:.reason,
  msg:((.last_assistant_message // .message // null) | if type=="string" then .[0:300] else null end),
  err:((.error // null) | if .==null then null elif type=="string" then .[0:300] else (tojson|.[0:300]) end),
  aid:.agent_id, at:.agent_type,
  desc:(if .tool_name=="Agent" then (((.tool_input | objects | .description) // null) | if type=="string" then .[0:120] else null end) else null end)}') || exit 0
[ -n "$line" ] || exit 0

# A Stop's whole reply (the line keeps 300 characters), for `pitwall wait`, up to 64 KB. Written before the line, so it
# is there when the app reads the Stop, and through a temp file, so no one ever reads half of it.
case "$line" in
  *'"e":"Stop",'*)
    d=$(dirname "$1")
    tmp="$d/.last-reply.$$"
    printf '%s' "$input" | "$JQ" -j '.last_assistant_message | strings' | head -c 65536 > "$tmp"
    if [ -s "$tmp" ]; then mv -f "$tmp" "$d/last-reply.txt"; else rm -f "$tmp"; fi ;;
esac

printf '%s\n' "$line" >> "$1"
exit 0
