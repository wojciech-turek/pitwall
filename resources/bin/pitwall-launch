#!/bin/sh
# pitwall Claude window entrypoint: usage pitwall-launch <sessionDir>.
# Each run of claude happens in a fresh subshell that sources env.sh and fetches the GitHub token into the
# environment only, so an edited project identity applies from the next relaunch. Setup runs once.
dir="$1"

load_identity() {
  . "$dir/env.sh"
  # The `pitwall` command (load_identity runs in a fresh subshell per launch, so this never stacks).
  [ -n "$PITWALL_CLI_DIR" ] && PATH="$PITWALL_CLI_DIR:$PATH" && export PATH
  if [ -n "$PITWALL_CLAUDE_ACCOUNT" ]; then
    # On an added Claude account, credentials inherited from the user's shell must not stand in for its login (Claude
    # prefers them). Drop them, then re-apply env.sh so one the project set on purpose stays.
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
    . "$dir/env.sh"
  fi
  if [ -n "$PITWALL_GH_ACCOUNT" ]; then
    # Tokens inherited from the user's shell must not stand in for the project's account (gh prefers them, even
    # for `gh auth token`). Drop them, then re-apply env.sh so the project's own extra variables stay.
    unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
    . "$dir/env.sh"
    GH_TOKEN=$(env -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
      "${PITWALL_GH_BIN:-gh}" auth token --hostname github.com --user "$PITWALL_GH_ACCOUNT" 2>/dev/null)
    if [ -n "$GH_TOKEN" ]; then
      export GH_TOKEN
    else
      # Fail closed: signed-out gh beats gh silently acting as whichever account is active.
      unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
      export GH_CONFIG_DIR="$PITWALL_SESSION_DIR/gh-unauthenticated"
      mkdir -p "$GH_CONFIG_DIR"
      echo "pitwall: couldn't get a GitHub token for $PITWALL_GH_ACCOUNT — gh commands will run signed out. Check \`gh auth status\`."
    fi
  fi
}

now() { echo $(($(date +%s) * 1000)); }
log_event() { printf '%s\n' "$1" >> "$PITWALL_EVENTS_FILE"; }
event_lines() { if [ -f "$PITWALL_EVENTS_FILE" ]; then wc -l < "$PITWALL_EVENTS_FILE" | tr -d ' '; else echo 0; fi; }

# Claude with the given arguments, then the first prompt if $first_prompt is set (it must come last).
# system-note.txt is appended to Claude's system prompt (the continue note, if any, then the agent note). A
# conversation continued from outside Pitwall (continue-note.txt) also has Claude rebuild its system prompt for this
# folder rather than reuse the recorded one (which names where it began). Before system-note.txt existed, the
# continue note was the whole of it.
start_claude() {
  note=
  if [ -e "$dir/system-note.txt" ]; then note="$dir/system-note.txt"
  elif [ -e "$dir/continue-note.txt" ]; then note="$dir/continue-note.txt"; fi
  if [ -e "$dir/continue-note.txt" ]; then set -- "$@" --system-prompt-snapshot off; fi
  if [ -n "$note" ]; then set -- "$@" --append-system-prompt-file "$note"; fi
  # After "--", so a prompt starting with a dash (a markdown bullet) is never read as an option.
  if [ -n "$first_prompt" ]; then set -- "$@" -- "$first_prompt"; fi
  "$PITWALL_CLAUDE_BIN" "$@"
}

# Whether Claude has a transcript of conversation $1 (<config dir>/projects/<any folder>/$1.jsonl); only lists folders.
has_transcript() {
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$1".jsonl; do
    [ -e "$f" ] && return 0
  done
  return 1
}

launch_new() {
  log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:launch\",\"mode\":\"new\"}"
  # A first prompt from the `pitwall` command: given once, then renamed so a relaunch never repeats it.
  first_prompt=
  if [ -e "$dir/initial-prompt.txt" ]; then
    first_prompt=$(cat "$dir/initial-prompt.txt")
    mv "$dir/initial-prompt.txt" "$dir/initial-prompt.sent"
    # The app keeps the session working through SessionStart, until this prompt's UserPromptSubmit.
    [ -n "$first_prompt" ] && log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:prompt-pending\"}"
  fi
  prompt_from=$(event_lines)
  start_claude --session-id "$id" --settings "$dir/hooks.json" --name "$PITWALL_TITLE"
  rc=$?
  # No SessionStart: Claude never began the conversation (No, exit at the folder-trust prompt), so the prompt never
  # reached it. Keep it for the next launch.
  if [ -n "$first_prompt" ] && [ -e "$dir/initial-prompt.sent" ] &&
    ! tail -n +"$((prompt_from + 1))" "$PITWALL_EVENTS_FILE" 2>/dev/null | grep -q '"e":"SessionStart"'; then
    mv "$dir/initial-prompt.sent" "$dir/initial-prompt.txt"
  fi
  first_prompt=
  return "$rc"
}

# One launch or resume; exits with claude's code. A subshell, so nothing from a previous env.sh lingers.
run_claude() (
  load_identity

  if [ -n "$PITWALL_SETUP_COMMAND" ] && [ ! -e "$dir/setup-done" ]; then
    echo "▸ Running setup: $PITWALL_SETUP_COMMAND"
    sh -c "$PITWALL_SETUP_COMMAND"
    rc=$?
    [ "$rc" -ne 0 ] && echo "▸ Setup command failed (exit $rc). Starting Claude anyway."
    : > "$dir/setup-done"
  fi

  id=$(cat "$dir/claude-id")
  if [ ! -e "$dir/started" ]; then
    : > "$dir/started"
    launch_new
    rc=$?
  else
    before=$(event_lines)
    log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:launch\",\"mode\":\"resume\"}"
    start_claude --resume "$id" --settings "$dir/hooks.json"
    rc=$?
    # Failed before SessionStart: the conversation never started, so start a new one with this id. Never over a
    # conversation continued from outside Pitwall whose transcript exists: Claude's error stands, Enter resumes again.
    if [ "$rc" -ne 0 ] && ! tail -n +"$((before + 1))" "$PITWALL_EVENTS_FILE" 2>/dev/null | grep -q '"e":"SessionStart"' &&
      ! { [ -e "$dir/continue-note.txt" ] && has_transcript "$id"; }; then
      if [ -e "$dir/moved-from" ]; then
        # Just moved to another account (the app wrote moved-from): a new conversation there would lose this one.
        # The app puts the session back; the marker is its to remove.
        log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:move-failed\",\"code\":$rc}"
        log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:exited\",\"code\":$rc}"
        exit "$rc"
      fi
      log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:exited\",\"code\":$rc}"
      echo "Couldn't resume the previous conversation — starting a new one."
      launch_new
      rc=$?
    fi
  fi
  log_event "{\"c\":\"$PITWALL_SESSION_ID\",\"t\":$(now),\"e\":\"pitwall:exited\",\"code\":$rc}"
  exit "$rc"
)

while :; do
  run_claude
  rc=$?
  echo "Claude exited (code $rc). Press Enter to resume."
  read -r _ || exit 0
done
