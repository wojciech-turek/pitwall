{
  "name": "pitwall",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An app for running many Claude Code agents in parallel (macOS; Windows in beta), each in its own worktree with the right git identity",
  "packageManager": "pnpm@12.16.1",
  "license": "MIT",
  "author": "Wojciech Turek",
  "repository": {
    "type": "git",
    "url": "https://github.com/wojciech-turek/pitwall.git"
  },
  "homepage": "https://github.com/wojciech-turek/pitwall",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:host": "node scripts/with-env.mjs PITWALL_SESSION_BACKEND=host -- playwright test",
    "test:e2e:host-launcher": "node scripts/with-env.mjs PITWALL_SESSION_BACKEND=host PITWALL_LAUNCHER=host PITWALL_E2E_NODE_STUBS=1 -- playwright test",
    "package": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && electron-vite build && electron-builder --mac dir --arm64",
    "dist": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && electron-vite build && electron-builder --mac dmg --arm64 --publish never",
    "package:win": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && electron-vite build && electron-builder --win dir -c.npmRebuild=false",
    "dist:win": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && electron-vite build && electron-builder --win nsis --publish never -c.npmRebuild=false",
    "verify:sign": "codesign --verify --deep --strict --verbose=2 release/mac-arm64/Pitwall.app",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
